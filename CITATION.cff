    family-names: "van Lierde"
    orcid: "https://orcid.org/0009-0006-6953-909X"
doi: "10.5281/zenodo.23460694"
repository-code: "https://github.com/simonvanlierde/sourceledger"
license: MIT
version: "0.5.0"
date-released: "2026-11-10"
keywords:
  - "provenance"
  - "data pipeline"
  - "reproducibility"
  - "open data"
  - "research software"
  - "FAIR"
