---
// Every docs page at <name>.html (index.md at the root), and a redirect page for each old
// address a page lists under `redirect_from`.
import { getCollection } from "astro:content";
import HomeInstall from "../components/HomeInstall.astro";
import RevisionExample from "../components/RevisionExample.astro";
import Base from "../layouts/Base.astro";

export async function getStaticPaths() {
  const pages = await getCollection("docs");
  return pages.flatMap((page) => {
    const path = page.id === "index" ? "/" : `/${page.id}.html`;
    return [
      { params: { slug: page.id === "index" ? undefined : page.id }, props: { page, path } },
      ...(page.data.redirect_from ?? []).map((from) => ({
        params: { slug: from.replace(/^\/|\.html$/g, "") },
        props: { to: path },
      })),
    ];
  });
}

// A page places a component with an HTML comment, which GitHub shows as nothing.
const includes = { "home-install": HomeInstall, "revision-example": RevisionExample };
const { page, path, to } = Astro.props;
const target = to && new URL(import.meta.env.BASE_URL.replace(/\/$/, "") + to, Astro.site).href;
const parts = page?.rendered.html.split(/<!-- include ([\w-]+) -->/) ?? [];
---

{
  to ? (
    <html lang="en">
      <meta charset="utf-8" />
      <title>Redirecting…</title>
      <link rel="canonical" href={target} />
      <script is:inline set:html={`location=${JSON.stringify(target)}`} />
      <meta http-equiv="refresh" content={`0; url=${target}`} />
      <meta name="robots" content="noindex" />
      <h1>Redirecting…</h1>
      <a href={target}>Click here if you are not redirected.</a>
    </html>
  ) : (
    <Base data={page.data} path={path}>
      {parts.map((part, i) => {
        const Include = includes[part];
        return i % 2 ? <Include /> : <Fragment set:html={part} />;
      })}
    </Base>
  )
}
