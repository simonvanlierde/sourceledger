# One ignore file for every stack in this repo.

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
htmlcov/
.coverage
coverage.xml
.hypothesis/

# Node
node_modules/
.pnpm-store/
*.tsbuildinfo
coverage/

# Rust
target/

# Test extras: Hypothesis's example database and what the mutation tools write
.hypothesis/
mutants/
.stryker-tmp/
# Stryker writes it beside the package, which may be nested.
**/reports/mutation/
mutants.out*/

# Local documentation build
_site/
.jekyll-cache/

# What `just site` builds from site/
/site/dist/
# Astro's generated types
/site/.astro/
